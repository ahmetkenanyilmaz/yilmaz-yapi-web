# İletişim formu — https://resend.com (ücretsiz plan yeterli)
# 1) API Keys üzerinden re_... anahtarı oluşturun
# 2) Domains > yilmazyapi.ltd ekleyip DNS kayıtlarını doğrulayın
# 3) Gönderen adres doğrulanmış domain'den olmalı
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@yilmazyapi.ltd
CONTACT_FROM_EMAIL=Yılmaz Yapı <info@yilmazyapi.ltd>

# Yerelde domain doğrulanmadan test için:
# CONTACT_FROM_EMAIL=Yılmaz Yapı <onboarding@resend.dev>
# CONTACT_TO_EMAIL= Resend hesabınızın e-posta adresi olmalı (test modu yalnızca oraya gider)

# Supabase (Dashboard > Project Settings > API)
# Sahte değer yazmayın; kendi projenizdeki gerçek değerleri ekleyin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 ölçüm kimliği (G-...)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
